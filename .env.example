# HealthPredict AI - Environment Configuration Example
# Copy this file to .env and add your valid Gemini API Key

# Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_api_key_here

# Flask Secret Key for session security and CSRF protection
SECRET_KEY=healthpredict-secret-key-change-in-production-2026

# Flask Environment Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
